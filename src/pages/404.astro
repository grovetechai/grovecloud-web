---
/**
 * Stránka pro neexistující adresu.
 *
 * ══ PROČ EXISTUJE ══════════════════════════════════════════════════════════
 * Není to jen ozdoba. Caddy podle přítomnosti `404.html` ve výstupu buildu
 * pozná, že tenhle web JE vícestránkový, a začne na neexistující adresy
 * odpovídat poctivým stavem 404 (viz shared/grovecloud-provision-plan.ts).
 *
 * Bez ní vracel Grove Cloud na každou neexistující URL homepage se stavem 200.
 * Google takovou stránku indexuje jako plnohodnotnou a náš vlastní skener ji
 * hlásí jako nález — hosting si tak srážel skóre konfigurací, kterou nastavil
 * sám sobě i klientům.
 */
import Layout from "../layouts/Base.astro";
import { prekladacZUrl } from "../i18n/utils";
const { t } = prekladacZUrl(Astro.url);
---
<Layout title={t("meta.404.t")} description={t("meta.404.d")}>
  <section class="wrap">
    <p class="kod">404</p>
    <h1>{t("e404.h1")}</h1>
    <p class="text">{t("e404.text")}</p>
    <h2 class="kamdal">{t("e404.kamdal")}</h2>
    <div class="odkazy">
      <a class="hlavni" href="/">{t("e404.zpet")}</a>
      <a class="vedlejsi" href="/cena">{t("nav.cenik")}</a>
      <a class="vedlejsi" href="/jak-to-funguje">{t("nav.jak")}</a>
      <a class="vedlejsi" href="/stav">{t("nav.stav")}</a>
    </div>
    <h3 class="sr-nadpis">{t("e404.hledate")}</h3>
    <p class="pod">
      {t("e404.hledate")}
      <a href="mailto:podpora@grovetechai.com">podpora@grovetechai.com</a>.
    </p>
  </section>
</Layout>

<style>
  .wrap { max-width: 720px; margin: 0 auto; padding: 96px 32px 110px; text-align: center; }
  .kod { font-size: 13px; letter-spacing: .18em; color: var(--muted); margin: 0 0 14px; font-weight: 700; }
  h1 { font-size: 36px; letter-spacing: -.02em; margin: 0 0 14px; }
  .text { font-size: 16.5px; color: var(--muted); line-height: 1.6; margin: 0 auto 34px; max-width: 46ch; }
  .kamdal { font-size: 15px; font-weight: 650; color: var(--muted); margin: 0 0 14px; letter-spacing: .01em; }
  .sr-nadpis { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .odkazy { display: flex; flex-wrap: wrap; gap: 10px; justify-content: center; }
  .hlavni {
    background: var(--navy); color: #fff; border-radius: 10px;
    padding: 11px 20px; font-weight: 650; font-size: 14.5px; text-decoration: none;
  }
  .vedlejsi {
    border: 1px solid var(--line); border-radius: 10px; color: var(--navy);
    padding: 11px 18px; font-size: 14.5px; text-decoration: none;
  }
  .pod { margin-top: 34px; font-size: 13.5px; color: var(--muted); }
  .pod a { color: var(--navy); }
  @media (max-width: 700px) { .wrap { padding: 64px 18px 80px; } h1 { font-size: 28px; } }
</style>
