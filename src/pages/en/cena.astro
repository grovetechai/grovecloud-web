---
/**
 * Nový ceník Grove (13. 10. 2026): hosting, bezpečnost a ochrana dat v AI
 * jsou jeden balíček — ceník žije na grovetechai.com/pricing.
 * Statický web neumí 301, proto meta refresh + canonical (bez inline skriptu, CSP drží).
 */
const CIL = "https://grovetechai.com/en/pricing";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${CIL}`} />
    <link rel="canonical" href={CIL} />
    <meta name="robots" content="noindex, follow" />
    <title>Grove — ceník</title>
  </head>
  <body>
    <p><a href={CIL}>{"en" === "en" ? "Pricing has moved to grovetechai.com/pricing →" : "Ceník najdeš na grovetechai.com/pricing →"}</a></p>
  </body>
</html>
