---
/**
 * Seznam článků (/blog). Jedna šablona pro všechny jazyky — viz komentář
 * v pages/bezpecnost.astro, proč nikdy nekopírovat text do jazykových stránek.
 */
import Base from "../layouts/Base.astro";
import { prekladacZUrl } from "../i18n/utils";
import { CLANKY } from "../data/clanky";
const { t, l, jazyk } = prekladacZUrl(Astro.url);
const fmt = (iso: string) => new Date(iso).toLocaleDateString(jazyk === "en" ? "en-GB" : jazyk === "sk" ? "sk-SK" : "cs-CZ", { day: "numeric", month: "long", year: "numeric" });
---
<Base title={t("meta.blog.t")} description={t("meta.blog.d")} path="/blog">
  <section>
    <div class="wrap">
      <div class="eyebrow">{t("blog.eyebrow")}</div>
      <h1 class="reveal" style="font-size:clamp(34px,4.6vw,54px);margin-top:10px">{t("blog.h1")}</h1>
      <p class="sub reveal" data-i="1">{t("blog.lead")}</p>
      <div class="seznam">
        {CLANKY.map((c) => (
          <a class="card reveal polozka" href={l(`/blog/${c.slug}`)}>
            <div class="n">{fmt(c.datum)} · {c.minut} {t("blog.min")}</div>
            <h3>{c.text[jazyk].titulek}</h3>
            <p>{c.text[jazyk].perex}</p>
            <span class="dal">{t("blog.cist")}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
  .seznam { display: grid; gap: 18px; margin-top: 34px; max-width: 820px; }
  .polozka { display: block; color: inherit; text-decoration: none; transition: transform .15s, box-shadow .15s; }
  .polozka:hover { transform: translateY(-2px); box-shadow: 0 10px 30px rgba(8,32,84,.08); }
  .polozka h3 { font-size: 22px; }
  .dal { display: inline-block; margin-top: 10px; color: var(--red); font-weight: 800; font-size: 14px; }
</style>
