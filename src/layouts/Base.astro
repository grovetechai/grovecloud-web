---
// Základní layout: meta, header, footer. Bez inline skriptů (CSP 'self').
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

interface Props {
  title: string;
  description: string;
  /** Cesta bez domény, např. "/cena". */
  path?: string;
}
const { title, description, path = "/" } = Astro.props;
const site = "https://grovecloud.cz";
const canonical = site + (path === "/" ? "/" : path);
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Grove Cloud" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="cs_CZ" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#082054" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
  </head>
  <body>
    <Header />
    <main><slot /></main>
    <Footer />
    <script src="../scripts/reveal.ts"></script>
  </body>
</html>
