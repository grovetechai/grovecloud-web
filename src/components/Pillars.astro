---
/**
 * Tři kroky nasazení + tři pilíře bezpečnosti.
 *
 * ══ CENA SE NEPÍŠE RUČNĚ ═══════════════════════════════════════════════════
 * Dřív tu stálo „99 Kč" napevno v textu. Na anglické a slovenské verzi by to
 * zůstalo v korunách, i když všude vedle svítí eura — a hlavně by se to
 * rozešlo s ceníkem, jakmile by se cena hnula. Bereme ji z pricing.json přes
 * stejný helper jako ceník, takže se změní na jednom místě.
 */
import pricing from "../data/pricing.json";
import { prekladacZUrl, cenaTarifu } from "../i18n/utils";
const { jazyk, t } = prekladacZUrl(Astro.url);
const KONTROL = pricing.checks.universal;
const statika: any = (pricing as any).stacks.find((x: any) => x.key === "static");
const STARTER = cenaTarifu(statika?.prices?.starter, jazyk) ?? "";

const kroky = [
  { n: "01", h: t("kroky.1.h"), p: t("kroky.1.p") },
  { n: "02", h: t("kroky.2.h"), p: t("kroky.2.p", { cena: STARTER }) },
  // POZOR NA FORMULACI (upřesněno 5. 9. 2026):
  // Automatické nasazení po pushi funguje, ale vyžaduje JEDNORÁZOVÉ vložení
  // webhooku do repozitáře — adresu i tajemství vygenerujeme, klient je jen
  // vloží v GitHubu. Dřív tu stálo „Pushni a zapomeň" bez zmínky o tom kroku,
  // takže to znělo, jako by se nemuselo dělat nic. Zjistili jsme to na sobě:
  // u vlastního webu ten webhook nikdo nezapojil a nasazení se nespouštělo.
  { n: "03", h: t("kroky.3.h"), p: t("kroky.3.p") },
];
const bezpecnost = [1, 2, 3].map((i) => ({
  n: t(`bezp.${i}.n` as any),
  h: t(`bezp.${i}.h` as any),
  p: t(`bezp.${i}.p` as any),
}));
---
<section id="jak">
  <div class="wrap">
    <div class="step">{t("kroky.step")}</div>
    <h2 class="reveal">{t("kroky.h2")}</h2>
    <p class="sub reveal" data-i="1">{t("kroky.sub")}</p>
    <div class="grid3">
      {kroky.map((k, i) => <div class="card reveal" data-i={i}><div class="n">{k.n}</div><h3>{k.h}</h3><p>{k.p}</p></div>)}
    </div>
  </div>
</section>
<section id="bezpecnost-sekce" style="padding-top:0">
  <div class="wrap">
    <div class="step">{t("bezp.step")}</div>
    <h2 class="reveal">{t("bezp.h2")}</h2>
    <p class="sub reveal" data-i="1">{t("bezp.sub", { n: KONTROL })}</p>
    <div class="grid3">
      {bezpecnost.map((k, i) => <div class="card reveal" data-i={i}><div class="n">{k.n}</div><h3>{k.h}</h3><p>{k.p}</p></div>)}
    </div>
  </div>
</section>
