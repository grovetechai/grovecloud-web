---
import pricing from "../data/pricing.json";
import { prekladacZUrl, cenaTarifu } from "../i18n/utils";
const { jazyk, t } = prekladacZUrl(Astro.url);
const KONTROL = pricing.checks.universal;
const statika: any = (pricing as any).stacks.find((x: any) => x.key === "static");
const STARTER = cenaTarifu(statika?.prices?.starter, jazyk) ?? "";
// Hero: nápis GROVE CLOUD složený z voxelů, které se sletí z prostoru a reagují
// na myš. Text je i v DOM (sr-only) kvůli SEO a čtečkám — canvas je jen vizuál.
const APP = "https://grovetechai.com/grovecloud";
---
<div class="hero">
  <div class="wrap">
    <div class="eyebrow">{t("hero.eyebrow")}</div>

    {/* Nadpis je vidět, ne schovaný ve čtečce.
        Do 5. 9. 2026 tu byl jen `sr-only` nadpis a canvas s nápisem GROVE CLOUD.
        Návštěvník tedy neviděl JEDINOU větu o tom, co produkt dělá — animace
        je hezká, ale neprodá. Canvas zůstává jako vizuál nad titulkem. */}
    <canvas id="vox" width="1100" height="300" aria-hidden="true"></canvas>

    <h1 class="titulek">
      {t("hero.h1a")}<br />
      <span class="zvyraz">{t("hero.h1b")}</span>
    </h1>

    <p class="lead">{t("hero.lead", { n: KONTROL })}</p>

    <div class="cta">
      <a class="btn red" id="cta-deploy" href={APP} rel="noopener">{t("hero.cta1")}</a>
      <a class="btn ghost" href="#zkus">{t("hero.cta2")}</a>
    </div>

    {/* Každý údaj musí být pravdivý: kartu při nasazení statiky opravdu
        nechceme, servery jsou v Německu a podpora je česká. */}
    <p class="pod-cta">{t("hero.podCta", { cena: STARTER })}</p>

    <p class="hint">{t("hero.hint")}</p>
  </div>
</div>
<script src="../scripts/voxel.ts"></script>
<style>
  .hero { padding: 56px 0 30px; text-align: center; }
  canvas { width: 100%; max-width: 1100px; height: auto; display: block; margin: 6px auto 0; }
  .titulek {
    margin: 10px auto 0; max-width: 900px;
    font-size: clamp(30px, 4.4vw, 50px); line-height: 1.12; letter-spacing: -.028em; font-weight: 800;
  }
  .zvyraz { color: var(--navy); }
  .lead { margin: 18px auto 0; font-size: 18px; color: var(--muted); max-width: 700px; line-height: 1.6; }
  .cta { margin-top: 28px; display: flex; gap: 12px; justify-content: center; flex-wrap: wrap; }
  .pod-cta { margin-top: 16px; font-size: 13.5px; color: var(--muted); }
  .hint { margin-top: 26px; font-size: 12px; color: var(--muted); }
  @media (max-width: 700px) {
    .hint { display: none; }
    .lead { font-size: 16px; }
    .pod-cta { font-size: 12.5px; line-height: 1.7; }
  }
</style>
