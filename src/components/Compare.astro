---
/**
 * Srovnání s běžným hostingem.
 *
 * ══ ŽÁDNÁ JMÉNA KONKURENCE ═════════════════════════════════════════════════
 * Vercel ani Cloudflare tu nejsou schválně. Tvrdit „tohle neumí" o konkrétní
 * službě znamená ručit za každý řádek — a jejich funkce se mění každý měsíc.
 * Srovnáváme s KATEGORIÍ („běžný hosting"), což je obhajitelné a nezastará.
 *
 * ══ KAŽDÝ ŘÁDEK MUSÍ MÍT KRYTÍ V PRODUKTU ══════════════════════════════════
 * Sloupec Grove Cloud smí obsahovat jen to, co existuje a je nasazené. Kde je
 * věc vázaná na tarif, píšeme to rovnou do buňky — „✓" u něčeho, co má jen
 * Business, by bylo zavádějící.
 */
import { prekladacZUrl } from "../i18n/utils";
const { t } = prekladacZUrl(Astro.url);
const ANO = t("srov.ano");
const radky = [
  { f: t("srov.r1"),  bezny: t("srov.ano"), grove: ANO, pozn: null },
  { f: t("srov.r2"),  bezny: t("srov.nekdy"), grove: ANO, pozn: t("srov.r2p") },
  { f: t("srov.r3"),  bezny: t("srov.vetsinou-ne"), grove: ANO, pozn: t("srov.r3p") },
  { f: t("srov.r4"),  bezny: t("srov.externi"), grove: ANO, pozn: null },
  { f: t("srov.r5"),  bezny: t("srov.castecne"), grove: ANO, pozn: t("srov.r5p") },
  { f: t("srov.r6"),  bezny: "—", grove: "GroveDefender", pozn: t("srov.r6p") },
  { f: t("srov.r7"),  bezny: t("srov.podle-sluzby"), grove: t("srov.kazdych10"), pozn: null },
  { f: t("srov.r8"),  bezny: t("srov.podle-sluzby"), grove: t("srov.podle-tarifu"), pozn: null },
  { f: t("srov.r9"),  bezny: "—", grove: t("srov.podle-tarifu"), pozn: null },
  { f: t("srov.r10"), bezny: "—", grove: ANO, pozn: null },
  { f: t("srov.r11"), bezny: "—", grove: ANO, pozn: t("srov.r11p") },
];

// „ano" vykreslíme jako fajfku, zbytek jako text — aby tabulka nelhala
// jednoduchostí tam, kde je odpověď podmíněná.
const jeAno = (v: string) => v === ANO;
---
<section class="srovnani" id="srovnani">
  <div class="wrap">
    <div class="step">{t("srov.step")}</div>
    <h2>{t("srov.h2")}</h2>
    <p class="sub">{t("srov.sub")}</p>

    <div class="obal">
      <table>
        <thead>
          <tr>
            <th scope="col">{t("srov.funkce")}</th>
            <th scope="col">{t("srov.bezny")}</th>
            <th scope="col" class="nas">Grove Cloud</th>
          </tr>
        </thead>
        <tbody>
          {radky.map((r) => (
            <tr>
              <th scope="row">
                {r.f}
                {r.pozn && <span class="pozn">{r.pozn}</span>}
              </th>
              <td class="bezny">{r.bezny}</td>
              <td class="nas">
                {jeAno(r.grove)
                  ? <span class="fajfka" aria-label={ANO}>✓</span>
                  : <span class="hodnota">{r.grove}</span>}
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>

<style>
  .srovnani { padding: 64px 0 20px; }
  h2 { font-size: clamp(24px, 3vw, 32px); letter-spacing: -.02em; margin: 6px 0 10px; }
  .sub { color: var(--muted); max-width: 66ch; line-height: 1.6; margin: 0 0 26px; }

  /* Vodorovný posun na úzkých displejích — tabulka se nesmí rozsypat. */
  .obal { overflow-x: auto; border: 1px solid var(--line); border-radius: 14px; }
  table { width: 100%; border-collapse: collapse; min-width: 560px; background: #fff; }
  th, td { text-align: left; padding: 13px 16px; border-bottom: 1px solid var(--line); font-size: 14px; }
  thead th { font-size: 12px; letter-spacing: .06em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  tbody th { font-weight: 600; }
  tbody tr:last-child th, tbody tr:last-child td { border-bottom: 0; }
  .pozn { display: block; margin-top: 3px; font-size: 12px; font-weight: 400; color: var(--muted); }
  td { text-align: center; white-space: nowrap; }
  thead th:not(:first-child) { text-align: center; }
  .bezny { color: var(--muted); }
  .nas { background: rgba(37,99,235,.035); }
  thead .nas { color: var(--navy); }
  .fajfka { color: #15803D; font-weight: 800; font-size: 16px; }
  .hodnota { color: var(--navy); font-weight: 650; font-size: 13px; }
</style>
