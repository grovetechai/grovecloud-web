---
import pricing from "../data/pricing.json";
import { prekladacZUrl, cenaTarifu } from "../i18n/utils";
const { jazyk, t } = prekladacZUrl(Astro.url);
const KONTROL = pricing.checks.universal;
const statika: any = (pricing as any).stacks.find((x: any) => x.key === "static");
const STARTER = cenaTarifu(statika?.prices?.starter, jazyk) ?? "";
// Bezpečnostní diagram: čím request projde, než se dostane k appce, a co běží
// trvale. Vrstvy se rozsvěcují postupně, jak sekce najede do obrazu.
//
// Obsah musí sedět 1:1 s tím, co doopravdy zapisujeme do sdíleného Caddy
// (shared/grovecloud-provision-plan.ts → GC_SECURITY_HEADERS). Žádná vrstva tu
// není proto, že hezky vypadá.
//
// Výčet hlaviček u vrstvy 03 je schválně BEZ překladu: jsou to doslovné názvy
// HTTP hlaviček. Přeložit „X-Frame-Options: DENY" by znamenalo napsat něco,
// co v odpovědi serveru nestojí.
const HLAVICKY = "HSTS · CSP · nosniff · X-Frame-Options: DENY · Referrer-Policy · Permissions-Policy";
const vrstvy = [1, 2, 3, 4, 5].map((i) => ({
  n: t(`mapa.${i}.n` as any),
  d: i === 3 ? HLAVICKY : t(`mapa.${i}.d` as any),
  k: `0${i}`,
}));
const trvale = [1, 2, 3].map((i) => ({
  n: t(`mapa.t${i}.n` as any),
  d: t(`mapa.t${i}.d` as any, { n: KONTROL }),
}));
---
<section id="jak-chranime" class="secmap">
  <div class="wrap">
    <div class="step">{t("mapa.step")}</div>
    <h2>{t("mapa.h2")}</h2>
    <p class="sub">{t("mapa.sub", { cena: STARTER })}</p>

    <ol class="chain" id="chain">
      {vrstvy.map((v) => (
        <li class="layer">
          <div class="k mono">{v.k}</div>
          <div>
            <h3>{v.n}</h3>
            <p>{v.d}</p>
          </div>
        </li>
      ))}
    </ol>

    <div class="eyebrow trvale-nad">{t("mapa.trvale")}</div>
    <div class="grid3">
      {trvale.map((t) => (
        <div class="card">
          <h3>{t.n}</h3>
          <p>{t.d}</p>
        </div>
      ))}
    </div>
  </div>
</section>
<script src="../scripts/secmap.ts"></script>
<style>
  .secmap { background: var(--soft); border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .chain { list-style: none; margin: 36px 0 0; padding: 0; display: grid; gap: 10px; position: relative; }
  .layer { display: flex; gap: 14px; align-items: flex-start; background: #fff; border: 1px solid var(--line); border-left: 3px solid var(--line); border-radius: 12px; padding: 16px 18px; opacity: .34; transform: translateY(10px); transition: opacity .45s, transform .45s, border-left-color .45s, box-shadow .45s; }
  .layer.lit { opacity: 1; transform: none; border-left-color: var(--red-ink); box-shadow: 0 8px 22px -16px rgba(8,32,84,.6); }
  .layer .k { font-size: 12px; font-weight: 800; color: var(--muted); padding-top: 2px; min-width: 24px; }
  .layer.lit .k { color: var(--red-ink); }
  .layer h3 { font-size: 16px; }
  .layer p { color: var(--muted); font-size: 14px; margin-top: 4px; }
  .trvale-nad { display: block; margin-top: 40px; }
  @media (prefers-reduced-motion: reduce) { .layer { opacity: 1; transform: none; transition: none; } }
</style>
