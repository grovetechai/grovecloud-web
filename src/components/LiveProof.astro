---
/**
 * „Tento web běží na Grove Cloud" — a tady je důkaz.
 *
 * ══ PROČ TO NENÍ JEN VĚTA V PATIČCE ════════════════════════════════════════
 * Nejsilnější reference, kterou máme, je vlastní provoz: tenhle web nasazujeme
 * stejným postupem jako aplikace zákazníků, prochází stejným skenem a hlídá ho
 * stejný dohled. Napsat to je snadné. Doložit to živými čísly je rozdíl mezi
 * marketingem a důkazem.
 *
 * ══ DATA JSOU ŽIVÁ, NE NAPSANÁ ═════════════════════════════════════════════
 * Stav se tahá z /api/grovecloud/status, tedy ze stejného zdroje jako stránka
 * /stav. Když se dotaz nepovede, řekneme to — nikdy nedosazujeme „vše v
 * pořádku" jako výchozí hodnotu.
 *
 * ══ CSP ════════════════════════════════════════════════════════════════════
 * Adresa jde do data atributu, ne do `define:vars`. To by Astro přeložilo na
 * inline skript, který `script-src 'self'` zablokuje — a sekce by zůstala
 * viset na pomlčkách.
 */
import pricing from "../data/pricing.json";
const KONTROL = pricing.checks.universal;
const API = "https://grovetechai.com/api/grovecloud/status";
---
<section class="dukaz" id="dukaz" data-api={API}>
  <div class="wrap">
    <div class="step">DŮKAZ</div>
    <h2>Tento web běží na Grove Cloud.</h2>
    <p class="sub">
      Každé nasazení téhle stránky projde stejným procesem jako aplikace zákazníků:
      build z GitHubu, bezpečnostní hlavičky ze sdíleného Caddy, {KONTROL} kontrol
      po nasazení a kontrola dostupnosti každých 10 minut. Tarif Starter, 99 Kč.
    </p>

    <div class="karty">
      <div class="karta">
        <div class="popis">Stav služby</div>
        <div class="hodnota" id="dp-stav">zjišťuji…</div>
        <div class="pod" id="dp-stav-pod">načítám z našeho rozhraní</div>
      </div>
      <div class="karta">
        <div class="popis">Poslední kontrola</div>
        <div class="hodnota" id="dp-kontrola">—</div>
        <div class="pod" id="dp-interval">měříme pravidelně</div>
      </div>
      <div class="karta">
        <div class="popis">Lokalita</div>
        <div class="hodnota">EU</div>
        <div class="pod">Hetzner, Norimberk · Německo</div>
      </div>
      <div class="karta">
        <div class="popis">Tarif tohoto webu</div>
        <div class="hodnota">Starter</div>
        <div class="pod">statika ze sdíleného serveru, 99 Kč</div>
      </div>
    </div>

    <p class="odkaz">
      Podrobný stav včetně toho, co nezveřejňujeme a proč, je na
      <a href="/stav">stránce Stav služby</a>.
    </p>
  </div>
</section>

<script src="../scripts/liveproof.ts"></script>

<style>
  .dukaz { padding: 64px 0 20px; }
  h2 { font-size: clamp(24px, 3vw, 32px); letter-spacing: -.02em; margin: 6px 0 10px; }
  .sub { color: var(--muted); max-width: 68ch; line-height: 1.6; margin: 0 0 28px; }
  .karty { display: grid; gap: 14px; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); }
  .karta { border: 1px solid var(--line); border-radius: 14px; padding: 16px; background: #fff; }
  .popis { font-size: 11px; letter-spacing: .07em; text-transform: uppercase; color: var(--muted); font-weight: 700; }
  .hodnota { font-size: 21px; font-weight: 800; letter-spacing: -.02em; margin: 7px 0 4px; }
  .pod { font-size: 12.5px; color: var(--muted); line-height: 1.45; }
  .odkaz { margin-top: 20px; font-size: 13.5px; color: var(--muted); }
  .odkaz a { color: var(--navy); }
</style>
