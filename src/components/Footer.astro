<style>
  .ftr { padding: 40px 32px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  .ftr a { color: var(--navy); text-decoration: none; }
  .ftr a:hover { text-decoration: underline; }
</style>
