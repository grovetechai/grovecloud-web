---
// Ceník 1:1 s aplikací. Čte src/data/pricing.json (generováno z enginu, needitovat).
// Server-side vykreslí výchozí (statika) → funguje i bez JS; přepínač typu appky řeší pricing.ts.
//
// ══ CENY SE FORMÁTUJÍ JEN TADY ═════════════════════════════════════════════
// Přepínač typu appky přepisuje ceny v prohlížeči. Kdyby si je formátoval sám,
// existovaly by dvě implementace téhož — a ta v JavaScriptu by se dřív nebo
// později rozešla s tou v Astru (jiná měna, jiný oddělovač tisíců, chybějící
// „od "). Proto tu předpočítáme HOTOVÉ řetězce pro každou kombinaci typu
// appky a tarifu a skript už jen přepíná text.
import pricing from "../data/pricing.json";
import { prekladacZUrl, cena as formatCena, MENA } from "../i18n/utils";
const { jazyk, t } = prekladacZUrl(Astro.url);
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const stacks = pricing.stacks;
const tiers = pricing.tiers;
const def: any = stacks[0];
type Cena = { czk: number; eur: number; usd: number } | null;
const mena = MENA[jazyk];
const APP = "https://grovetechai.com/grovecloud";

/** Hotový popisek ceny pro jeden tarif, nebo null když tarif pro daný typ neexistuje. */
function popisCeny(p: Cena, tierKey: string): string | null {
  if (!p) return null;
  const castka = mena === "czk" ? p.czk : p.eur;
  // Starter má pevnou cenu, ostatní tarify se od základu odvíjejí nahoru.
  const predpona = tierKey === "starter" ? "" : t("cenik.od");
  return `${predpona}${formatCena(castka, mena, jazyk)}`;
}

const defPrices = def.prices as Record<string, Cena>;
// Mapa {typ appky → {tarif → hotový text}}. Do stránky jde jako JSON, ne jako
// skript — CSP `script-src 'self'` by inline skript zablokovala.
const cenyProSkript: Record<string, Record<string, string | null>> = {};
for (const s of stacks as any[]) {
  cenyProSkript[s.key] = {};
  for (const tier of tiers) {
    cenyProSkript[s.key][tier.key] = popisCeny(s.prices?.[tier.key] ?? null, tier.key);
  }
}
---
<section id="cena" class="pricing">
  <div class="wrap">
    <div class="step">{t("cenik.step")}</div>
    <h2 class="reveal">{t("cenik.h2")}</h2>
    <p class="sub reveal" data-i="1">{t("cenik.sub")}</p>
    <div class="stackpick" role="tablist" aria-label={t("cenik.typ")}>
      {stacks.map((s, i) => <button type="button" role="tab" aria-selected={i === 0 ? "true" : "false"} data-stack={s.key}>{t(`stack.${s.key}` as any)}</button>)}
    </div>
    <div class="tiers" id="tiers">
      {tiers.map((tier) => {
        const p = defPrices[tier.key];
        const popis = popisCeny(p, tier.key);
        return (
          <div class:list={["tier", { hl: tier.highlighted, off: !p }]} data-tier={tier.key}>
            {tier.comingSoon && <span class="soon">{t("cenik.pripravujeme")}</span>}
            {/* Název tarifu se nepřekládá — Starter, Secure Host… jsou značky. */}
            <h3 class="name">{tier.name}</h3>
            <div class="price" data-price>
              {popis ? <>{popis}<small>{t("cenik.mesic")}</small></> : <span class="na">{t("cenik.jenStatika")}</span>}
            </div>
            <div class="from">{t(`tarif.${tier.key}.sla` as any)} · {t(`tarif.${tier.key}.resp` as any)}</div>
            {!compact && <ul>{[1, 2, 3, 4].map((i) => <li>{t(`tarif.${tier.key}.${i}` as any)}</li>)}</ul>}
            {!compact && <a class="btn small" href={tier.onRequest ? "mailto:cloud@grovetechai.com?subject=Grove%20Cloud%20Business" : APP} rel="noopener">{tier.onRequest ? t("cenik.domluvit") : tier.comingSoon ? t("cenik.zajem") : t("cenik.nasadit")}</a>}
          </div>
        );
      })}
    </div>
    <p class="note">{t("cenik.pozn", { kurz: pricing.eurCzk, datum: pricing.generatedAt.slice(0, 10) })}</p>
  </div>
  <script type="application/json" id="pricing-json" set:html={JSON.stringify({ ceny: cenyProSkript, mesic: t("cenik.mesic"), jenStatika: t("cenik.jenStatika") })}></script>
</section>
<script src="../scripts/pricing.ts"></script>
<style>
  .pricing { background: #fff; }
  .stackpick { margin-top: 24px; display: flex; gap: 8px; flex-wrap: wrap; }
  .stackpick button { border: 1px solid var(--line); background: #fff; padding: 8px 12px; border-radius: 99px; font-size: 13px; cursor: pointer; font-family: inherit; }
  .stackpick button[aria-selected="true"] { background: var(--navy); color: #fff; border-color: var(--navy); }
  .stackpick button:focus-visible { outline: 3px solid var(--blue2); }
  .tiers { display: grid; grid-template-columns: repeat(4, 1fr); gap: 16px; margin-top: 32px; }
  .tier { border: 1px solid var(--line); border-radius: 14px; padding: 22px; position: relative; background: #fff; display: flex; flex-direction: column; transition: opacity .3s; }
  .tier.hl { border-color: var(--navy); box-shadow: 0 12px 40px rgba(8,32,84,.12); }
  .tier.off { opacity: .55; }
  .name { font-weight: 800; font-size: 17px; }
  .price { font-size: 32px; font-weight: 850; letter-spacing: -.03em; margin: 10px 0 2px; }
  .price :global(small) { font-size: 13px; color: var(--muted); font-weight: 500; margin-left: 4px; }
  .price :global(.na) { font-size: 18px; color: var(--muted); font-weight: 600; }
  .from { font-size: 12px; color: var(--muted); }
  .tier ul { list-style: none; margin: 14px 0 18px; font-size: 13.5px; color: #334; line-height: 1.7; flex: 1; }
  .tier ul li::before { content: "■ "; color: var(--red); font-size: 9px; vertical-align: middle; }
  .soon { position: absolute; top: 14px; right: 14px; font-size: 10px; letter-spacing: .1em; background: #eef1f8; color: var(--navy); padding: 4px 8px; border-radius: 99px; font-weight: 700; }
  .btn.small { padding: 10px 14px; font-size: 14px; justify-content: center; }
  .note { margin-top: 14px; font-size: 12px; color: var(--muted); }
  @media (max-width: 1000px) { .tiers { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .tiers { grid-template-columns: 1fr; } }
</style>
