    stehovat: "Přestěhujeme ti web",
    stehovatPredmet: "Stěhování WordPressu na Grove Cloud",
    duvera: "PHP 8.4 · MariaDB · zálohy co 6 h · data v EU · bez karty",
    koren: "GROVE WORDPRESS",
    vetve: [["Záplaty", "PHP i WordPress, bez tvého kliknutí"], ["PHP štít", "při díře, než vyjde oprava"], ["Zálohy", "co 6 hodin, 2 servery"], ["Grove Check", "sken webu a pluginů v ceně"]],
    pribehK: "Středa 21. října 2026 · díra v PHP (PHP2Shell)",
    pribeh: [["Útoky začaly.", "Oprava PHP vyšla až v 16:00. Kdo čekal na hosting nebo správce, byl šest hodin pozadu. Úřady v Nizozemsku a Finsku weby radši vypnuly."], ["Štít nahoře.", "Na Grove Cloudu zapneme PHP štít na všech webech najednou: útok se zastaví dřív, než se dostane k PHP. Opravu pak nasadíme sami, jakmile vyjde — ty nemusíš dělat nic."]],
    hlidameH: "Co hlídáme my.",
    hlidame: [
      ["Záplaty ve stejný den", "Nová verze PHP nebo WordPressu? Přestavíme nejdřív jeden web na zkoušku, pak ostatní. Když neprojde kontrolou, běží dál ta stará."],
      ["PHP štít", "Virtuální záplata při díře, na kterou ještě není oprava. Zastaví útok před PHP — na všech webech jedním přepnutím."],
      ["Zálohy co 6 hodin", "Databáze i média, kopie na druhém serveru a každý týden zkouška obnovy, že ze zálohy jde web opravdu vrátit."],
      ["Grove Check v ceně", "Pravidelný sken webu. Zranitelný plugin? Dozvíš se to od nás dřív než od útočníka — i s tím, co aktualizovat."],
    ],
    vychoziK: "Zapnuté od prvního dne",
    vychoziH: "Bezpečné nastavení, které nikdo nezapomene.",
    vychoziP: "Všechny weby běží z jedné image, kterou udržujeme my. Žádný web není výjimka.",
