    cena: UKAZAT_CENU ? `Grove WordPress ${KC(CENA_WEB)} měsíčně za web` : "Grove WordPress — 14 dní zdarma",
    cenaPod: UKAZAT_CENU ? "14 dní zdarma bez karty. Prvních 10 webů přestěhujeme zdarma. Ceny bez DPH, faktura v korunách." : "Bez platební karty. Faktura v korunách, data v EU.",
    cenaCta: "Vyzkoušet zdarma",
