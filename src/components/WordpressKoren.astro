      ["Ako sa k vám web presťahuje?", "Pošleš nám prístup k súčasnému hostingu alebo zálohu. Web prenesieme, otestujeme na našej adrese a až potom prepneme doménu."],
      ["Čo keď plugin rozbije web?", "Vrátime poslednú zálohu (najviac 6 hodín starú) a povieme ti, ktorý plugin to bol."],
      ["Posiela WordPress e-maily?", "Cez plugin pre SMTP a tvoju e-mailovú službu. Pomôžeme ti ho nastaviť."],
      ["Kde sú dáta?", "Na serveroch v Norimbergu (EÚ), zálohy na druhom serveri tamtiež. Žiadny prenos mimo EÚ."],
    ],
  },
}[jazyk];

const href = (h: string) => (h.startsWith("http") ? h : l(h));
---
<div class="wp">
  <header class="wp-hlava">
    <span class="wp-znacka">
      <a href={G} aria-label="Grove Tech AI"><img src="/grove-logo-white.png" alt="Grove Tech AI" width="116" height="38" /></a>
      <a class="wp-mono wp-cloud" href={l("/")}>/ cloud</a>
    </span>
    <nav class="wp-nav" aria-label="Menu">
      {T.nav.map(([n, h]) => (
        <a href={href(h)} rel={h.startsWith("http") ? "noopener" : undefined} aria-current={h === "/wordpress" ? "page" : undefined} class:list={{ akt: h === "/wordpress" }}>{n}</a>
      ))}
      <span class="wp-jazyky" role="group" aria-label="Jazyk">
        {jazyky.map((j) => <a href={j.href} hreflang={j.kod} aria-current={j.akt ? "true" : undefined} class:list={{ akt: j.akt }}>{j.kod.toUpperCase()}</a>)}
      </span>
      <a class="wp-login" href={appUrl("nav-login")} rel="noopener">{T.login}</a>
    </nav>
    <a class="wp-mlogin" href={appUrl("nav-login")} rel="noopener">{T.login}</a>
  </header>

  <section class="wp-hero">
    <div class="wp-text">
      <p class="wp-mono wp-eyebrow">{T.eyebrow}</p>
      <h1 class="wp-h1">{T.h1[0]}<br />{T.h1[1]}<br /><span>{T.h1[2]}</span></h1>
      <p class="wp-sub">{T.sub}</p>
      <div class="wp-tl">
        <a class="wp-btn" href={appUrl("wp-hero")} rel="noopener">{T.cta}</a>
        <a class="wp-link" href={mail(T.stehovatPredmet)}>{T.stehovat} →</a>
      </div>
      <p class="wp-mono wp-duvera">{T.duvera}</p>
    </div>

    <div class="wp-strom" aria-hidden="true">
      <div class="wp-koren">
        <span class="wp-dot wp-dot-velka"><span></span></span>
        <span class="wp-mono wp-korenl">{T.koren}</span>
      </div>
      <div class="wp-kmen"></div>
      <div class="wp-vetve">
        {T.vetve.map(([n, p]) => (
          <div class="wp-vetev">
            <span class="wp-dot"><span></span></span>
            <b>{n}</b>
            <span class="wp-mono">{p}</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="wp-sekce wp-sekce-cara">
    <div class="wp-wrap">
      <p class="wp-mono wp-kicker">{T.pribehK}</p>
      <div class="wp-dve">
        <div class="wp-karta"><div class="wp-mono wp-cas">9:43</div><h2 class="wp-kn">{T.pribeh[0][0]}</h2><p>{T.pribeh[0][1]}</p></div>
        <div class="wp-karta wp-karta-r"><div class="wp-mono wp-cas wp-r">9:43</div><h2 class="wp-kn">{T.pribeh[1][0]}</h2><p>{T.pribeh[1][1]}</p></div>
      </div>
    </div>
  </section>

  <section class="wp-sekce">
    <div class="wp-wrap">
      <h2 class="wp-h2">{T.hlidameH}</h2>
      <div class="wp-ctyri">
        {T.hlidame.map(([n, p]) => <div class="wp-bod4"><h3>{n}</h3><p>{p}</p></div>)}
      </div>
    </div>
  </section>

  <section class="wp-sekce wp-sekce-mala">
    <div class="wp-wrap">
      <div class="wp-box wp-vychozi">
        <div class="wp-vychozi-t">
          <p class="wp-mono wp-kicker wp-r">{T.vychoziK}</p>
          <h2 class="wp-h2b">{T.vychoziH}</h2>
          <p class="wp-p">{T.vychoziP}</p>
        </div>
        <ul class="wp-mono wp-seznam">
          {T.vychozi.map((x) => <li><span class="wp-r" aria-hidden="true">✓</span> {x}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="wp-sekce">
    <div class="wp-wrap">
      <h2 class="wp-h2">{T.hraniceH}</h2>
      <div class="wp-dve">
        <div class="wp-karta wp-karta-r"><h3 class="wp-r">{T.nase[0]}</h3><p>{T.nase[1]}</p></div>
        <div class="wp-karta"><h3>{T.tvoje[0]}</h3><p>{T.tvoje[1]}</p></div>
      </div>
    </div>
  </section>

  <section class="wp-sekce wp-sekce-mala">
    <div class="wp-wrap">
      <div class="wp-box wp-radek">
        <div class="wp-radek-t">
          <span class="wp-mono wp-stitek">{T.dodK}</span>
          <h2 class="wp-h2b">{T.dodH}</h2>
          <p class="wp-p">{T.dodP}</p>
        </div>
        <a class="wp-obrys" href={mail(T.dodPredmet)}>{T.dodCta}</a>
      </div>
    </div>
  </section>

  <section class="wp-sekce wp-sekce-mala">
    <div class="wp-wrap">
      <div class="wp-cena">
        <div><div class="wp-cn">{T.cena}</div><div class="wp-cp">{T.cenaPod}</div></div>
        <a class="wp-bila" href={appUrl("wp-cena")} rel="noopener">{T.cenaCta}</a>
      </div>
    </div>
  </section>

  <section class="wp-sekce">
    <div class="wp-wrap">
      <h2 class="wp-h2">{T.faqH}</h2>
      <div class="wp-faq">
        {T.faq.map(([q, a]) => <div><h3>{q}</h3><p>{a}</p></div>)}
      </div>
    </div>
  </section>

  <nav class="wp-mnav" aria-label="Menu">{T.nav.map(([n, h]) => <a href={href(h)} aria-current={h === "/wordpress" ? "page" : undefined}>{n}</a>)}</nav>
</div>

<style>
  .wp { --r: #FF2A3D; --ink: #F2F3F5; --mut: #A3A8B3; --mut2: #6E737D; background: #050506; color: var(--ink); font-family: "Manrope Variable", Manrope, system-ui, sans-serif; overflow-x: clip; }
  .wp a { color: var(--ink); text-decoration: none; }
  .wp a:hover { color: #fff; }
  .wp a:focus-visible { outline: 2px solid #FF5A69; outline-offset: 4px; border-radius: 8px; }
  .wp h1, .wp h2, .wp h3, .wp p { margin: 0; }
  .wp-mono { font-family: "JetBrains Mono Variable", "JetBrains Mono", ui-monospace, monospace; }
  .wp-r { color: var(--r) !important; }

  /* hlavička — stejná jako na úvodu */
  .wp-hlava { max-width: 1440px; margin: 0 auto; box-sizing: border-box; padding: 28px 56px; display: flex; align-items: center; justify-content: space-between; gap: 16px; }
  .wp-znacka { display: flex; align-items: center; gap: 12px; }
  .wp-znacka img { height: 38px; width: auto; display: block; }
  .wp-cloud { font-size: 13px; color: var(--mut) !important; letter-spacing: .04em; }
  .wp-nav { display: flex; align-items: center; gap: 24px; font-size: 15px; }
