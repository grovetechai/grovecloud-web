    dodK: "Pripravujeme",
    dodH: "Spravuješ weby obcí alebo firiem?",
    dodP: "Jeden účet na desiatky webov, súhrnný prehľad a report pre každého klienta pod tvojou hlavičkou. Vzťah s klientom zostáva tvoj, prevádzku a bezpečnosť držíme my.",
    dodCta: "Chcem vedieť viac",
    dodPredmet: "Grove WordPress pre dodávateľov webov",
