    hlidameH: "What we watch.",
    hlidame: [
      ["Same-day patches", "New PHP or WordPress version? We rebuild one site first as a test, then the rest. If it fails the checks, the old one keeps running."],
      ["PHP shield", "A virtual patch for a hole that has no fix yet. Stops the attack before PHP — on every site with one switch."],
      ["Backups every 6 hours", "Database and media, a copy on a second server and a weekly restore drill proving the site really comes back."],
      ["Grove Check included", "Regular site scans. Vulnerable plugin? You hear it from us before an attacker finds it — with what to update."],
    ],
    vychoziK: "On from day one",
    vychoziH: "Secure settings nobody forgets.",
    vychoziP: "Every site runs from one image that we maintain. No site is an exception.",
    vychozi: ["XML-RPC off", "no PHP in uploaded files", "WordPress version hidden", "admin file editor off", "install only with the owner's key", "plugins update themselves", "site doesn't run as root", "each site on its own network"],
    hraniceH: "A clear line.",
    nase: ["Ours", "Server, PHP, WordPress core, database, backups, security and keeping the site up."],
    tvoje: ["Yours", "Content, plugins and design. If a plugin breaks the site, we restore a backup and tell you which one it was."],
    dodK: "Coming soon",
    dodH: "Run websites for towns or companies?",
    dodP: "One account for dozens of sites, a combined overview and a report for each client under your name. The client relationship stays yours; we run operations and security.",
    dodCta: "Tell me more",
    dodPredmet: "Grove WordPress for web agencies",
    cena: UKAZAT_CENU ? `Grove WordPress ${KC(CENA_WEB)} per site per month` : "Grove WordPress — 14 days free",
    cenaPod: UKAZAT_CENU ? "14 days free, no card. We move your first 10 sites for free. Prices excl. VAT." : "No credit card. Data in the EU.",
    cenaCta: "Try it free",
    faqH: "What people ask.",
    faq: [
      ["How does my site move to you?", "Send us access to your current hosting or a backup. We move the site, test it on our address and only then switch the domain."],
      ["What if a plugin breaks the site?", "We restore the latest backup (at most 6 hours old) and tell you which plugin it was."],
      ["Does WordPress send emails?", "Through an SMTP plugin and your email service. We'll help you set it up."],
      ["Where is the data?", "On servers in Nuremberg (EU), backups on a second server there too. Nothing leaves the EU."],
    ],
  },
  sk: {
    nav: [["Ako funguje", "/jak-to-funguje"], ["WordPress", "/wordpress"], ["Bezpečnosť", "/bezpecnost"], ["Cenník", CENIK], ["Stav", "/stav"], ["Blog", "/blog"]],
    login: "Prihlásiť",
    eyebrow: "Koreň prevádzky · WordPress",
    h1: ["WordPress.", "Záplatujeme.", "Postrážime."],
    sub: "Spravovaný WordPress v EÚ. Keď vyjde diera v PHP, opravu nasadíme my. Keď je zraniteľný plugin, dozvieš sa to od nás skôr ako od útočníka.",
    cta: "Vyskúšať 14 dní zadarmo",
    stehovat: "Presťahujeme ti web",
    stehovatPredmet: "Sťahovanie WordPressu na Grove Cloud",
    duvera: "PHP 8.4 · MariaDB · zálohy každých 6 h · dáta v EÚ · bez karty",
    koren: "GROVE WORDPRESS",
    vetve: [["Záplaty", "PHP aj WordPress, bez tvojho kliknutia"], ["PHP štít", "pri diere, kým vyjde oprava"], ["Zálohy", "každých 6 hodín, 2 servery"], ["Grove Check", "sken webu a pluginov v cene"]],
    pribehK: "Streda 21. októbra 2026 · diera v PHP (PHP2Shell)",
    pribeh: [["Útoky začali.", "Oprava PHP vyšla až o 16:00. Kto čakal na hosting alebo správcu, bol šesť hodín pozadu. Úrady v Holandsku a Fínsku weby radšej vypli."], ["Štít hore.", "Na Grove Cloude zapneme PHP štít na všetkých weboch naraz: útok sa zastaví skôr, než sa dostane k PHP. Opravu potom nasadíme sami, hneď ako vyjde — ty nemusíš robiť nič."]],
    hlidameH: "Čo strážime my.",
    hlidame: [
      ["Záplaty v ten istý deň", "Nová verzia PHP alebo WordPressu? Prestavíme najprv jeden web na skúšku, potom ostatné. Keď neprejde kontrolou, beží ďalej tá stará."],
      ["PHP štít", "Virtuálna záplata pri diere, na ktorú ešte nie je oprava. Zastaví útok pred PHP — na všetkých weboch jedným prepnutím."],
      ["Zálohy každých 6 hodín", "Databáza aj médiá, kópia na druhom serveri a každý týždeň skúška obnovy, že zo zálohy sa web naozaj vráti."],
      ["Grove Check v cene", "Pravidelný sken webu. Zraniteľný plugin? Dozvieš sa to od nás skôr ako od útočníka — aj s tým, čo aktualizovať."],
    ],
    vychoziK: "Zapnuté od prvého dňa",
    vychoziH: "Bezpečné nastavenie, na ktoré nikto nezabudne.",
    vychoziP: "Všetky weby bežia z jednej image, ktorú udržiavame my. Žiadny web nie je výnimka.",
    vychozi: ["XML-RPC vypnuté", "žiadne PHP v nahraných súboroch", "verzia WordPressu skrytá", "editor súborov v administrácii vypnutý", "inštalácia len s kľúčom vlastníka", "pluginy sa aktualizujú samy", "web nebeží ako root", "každý web v oddelenej sieti"],
