---
// Stránka grovecloud.cz/wordpress — Grove WordPress (návrh schválen 26. 10. 2026).
//
// Styl „Kořen“ jako úvod (HomeKoren.astro): tmavé pozadí, červená #FF2A3D,
// Manrope + JetBrains Mono, karty 9:43 jako 3:14 na úvodu. Strom v hero je
// kořen Grove WordPress a čtyři větve — to, co za zákazníka hlídáme.
//
// Žádný JavaScript (CSP `script-src 'self'` tu nic neřeší) — stránka je úplná
// i bez skriptů.
//
// CENA: 690 Kč/web je zatím návrh z analýzy (claude/grove-wordpress-analyza).
// Dokud ji Ondřej nepotvrdí, UKAZAT_CENU = false → místo ceny jen 14 dní zdarma.
// Po potvrzení přepnout na true (a zkontrolovat CENA_WEB).
//
// FAKTA o PHP2Shell (21. 10. 2026): první útoky 7:43 UTC = 9:43 SELČ, opravy
// PHP 14:00 UTC = 16:00 SELČ, úřady v NL a FI weby preventivně vypnuly.
// Zdroj: claude/linkedin-php2shell-kdo-ceka-2026-10-22 (CERT-EU 2026-018).
const UKAZAT_CENU = false;
const CENA_WEB = 690;
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import { odkaz, cestaBezJazyka } from "../i18n/utils";
import { JAZYKY, type Jazyk } from "../i18n/ui";
import { appUrl } from "../lib/app-url";
interface Props { jazyk: Jazyk }
const { jazyk } = Astro.props;
const l = (c: string) => odkaz(jazyk, c);
const G = "https://grovetechai.com";
const CENIK = jazyk === "en" ? `${G}/en/pricing` : `${G}/pricing`;
const KC = (n: number) => jazyk === "en" ? `${n.toLocaleString("en-US")} CZK` : `${n.toLocaleString(jazyk === "sk" ? "sk-SK" : "cs-CZ")} Kč`;
const cista = cestaBezJazyka(Astro.url);
const jazyky = (Object.keys(JAZYKY) as Jazyk[]).map((j) => ({ kod: j, href: odkaz(j, cista), akt: j === jazyk }));
const mail = (predmet: string) => `mailto:cloud@grovetechai.com?subject=${encodeURIComponent(predmet)}`;

const T = {
  cs: {
    nav: [["Jak funguje", "/jak-to-funguje"], ["WordPress", "/wordpress"], ["Bezpečnost", "/bezpecnost"], ["Ceník", CENIK], ["Stav", "/stav"], ["Blog", "/blog"]],
    login: "Přihlásit",
    eyebrow: "Kořen provozu · WordPress",
    h1: ["WordPress.", "Záplatujeme.", "Pohlídáme."],
    sub: "Spravovaný WordPress v EU. Když vyjde díra v PHP, opravu nasadíme my. Když je zranitelný plugin, dozvíš se to od nás dřív než od útočníka.",
