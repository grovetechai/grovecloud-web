---
// Domovská stránka grovecloud.cz — návrh G „Příkaz“ (3. 10. 2026).
// Jeden komponent pro CS i EN (texty v T). Animace jsou čisté CSS + malý
// skript pro psaní příkazu; při prefers-reduced-motion se vše ukáže hned.
import "@fontsource-variable/manrope";
import "@fontsource-variable/jetbrains-mono";
import pricing from "../data/pricing.json";
import { cenaTarifu, odkaz } from "../i18n/utils";
import type { Jazyk } from "../i18n/ui";
interface Props { jazyk: Jazyk }
const { jazyk } = Astro.props;
// Ceny 1:1 s aplikací (pricing.json se generuje z hlavního repa).
const st: any = (pricing as any).stacks;
const WEB = cenaTarifu(st.find((x: any) => x.key === "static")?.prices?.starter, jazyk) ?? "";
const APPKA = cenaTarifu(st.find((x: any) => x.key === "api")?.prices?.host, jazyk) ?? "";
const NULA = cenaTarifu({ czk: 0, eur: 0, usd: 0 }, jazyk) ?? "0";

const APP = "https://grovetechai.com/grovecloud";
const utm = (c: string) => `${APP}?utm_source=grovecloud.cz&utm_medium=web&utm_campaign=${c}`;
const DOCS = "https://grovetechai.com/docs/grovecloud";

const T = {
  cs: {
    eyebrow: "Jak nasadit appku na GroveCloud:",
    prikaz: "nasaď mi appku",
    vysledky: [
      ["✓ appka založena", "ok"],
      ["… build · kontrola · přepnutí", "bezi"],
      ["✓ nasazeno za 1:13", "ok"],
      ["✓ moje-appka.grovecloud.cz", "ok"],
      ["✓ skóre 94/100", "red"],
